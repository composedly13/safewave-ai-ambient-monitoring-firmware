# SafeWave-AI CSI node — sdkconfig.defaults
# PlatformIO + ESP-IDF v5.x  (auto-applied at build time)

# CPU
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ_240=y

# PSRAM — N16R8 8 MB Octal
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_USE_MALLOC=y

# Flash — N16R8 = 16 MB (bootloader header must match the chip)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
# Partition table set via board_build.partitions in platformio.ini

# FreeRTOS — 1 ms tick so 10 ms send period is exact
CONFIG_FREERTOS_HZ=1000

# WiFi CSI — required for esp_wifi_set_csi_config / rx_cb.
# Correct Kconfig symbol for ESP-IDF 6.0.1 (the old CONFIG_ESP_WIFI_ENABLE_WIFI_CSI
# name was silently ignored → CSI not built in → set_csi_config returned ESP_FAIL).
CONFIG_ESP_WIFI_CSI_ENABLED=y

# LWIP
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
CONFIG_LWIP_SO_RCVBUF=y

# SNTP
CONFIG_LWIP_SNTP_MAX_SERVERS=1

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
